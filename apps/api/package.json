  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@kortex/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  }
